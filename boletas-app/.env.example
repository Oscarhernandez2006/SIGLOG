# Configuración de PostgreSQL para boletas-app
# Copiá este archivo como .env y ajustá los valores.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/boletas

# Para servicios cloud (Supabase, Neon, RDS, etc.) usar la URL que provee
# el proveedor; el shim activa SSL automáticamente cuando contiene
# `sslmode=require`. Ejemplo:
# DATABASE_URL=postgres://user:pass@host:5432/dbname?sslmode=require
